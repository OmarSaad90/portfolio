# Web3Forms access key — get yours at https://web3forms.com (verify your email, key is sent to you)
# Set this in Netlify under Site settings → Environment variables as well.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Full production URL once the domain is live, e.g. https://briefbuild.com (no trailing slash).
# Drives metadataBase, canonical links, the sitemap, and robots.txt. Falls back to a
# placeholder if unset, so set this in Netlify too once the domain is registered.
NEXT_PUBLIC_SITE_URL=
